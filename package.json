{
  "name": "meld-desktop",
  "private": true,
  "version": "0.3.0",
  "license": "GPL-3.0-only",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "tauri": "tauri",
    "test:scripts": "node --test scripts/tests/*.test.mjs",
    "check:versions": "node scripts/check-versions.mjs",
    "check:security": "node scripts/check-security-config.mjs",
    "check:ui": "node scripts/check-ui-invariants.mjs",
    "test": "vitest run",
    "check:tooling": "node scripts/check-tooling.mjs",
    "lint": "eslint . --max-warnings 8",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tauri-apps/cli": "^2.12.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.9",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.0.4",
    "vitest": "^3.2.7"
  }
}
