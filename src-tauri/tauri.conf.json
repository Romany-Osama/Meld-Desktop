{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Meld Desktop",
  "version": "../package.json",
  "identifier": "com.romany-osama.meld-desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Meld Desktop",
        "width": 1120,
        "height": 720,
        "minWidth": 860,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: https: asset: https://asset.localhost http://asset.localhost; media-src 'self' https://*.googlevideo.com asset: https://asset.localhost http://asset.localhost; connect-src 'self' asset: https://asset.localhost http://asset.localhost https://ipc.localhost http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/Meld Desktop/downloads/**",
          "$APPDATA/Meld Desktop/player-cache/**",
          "$APPDATA/Meld Desktop/artwork/**"
        ]
      }
    }
  },
  "plugins": {
    "taskbar": {
      "autoAttach": true,
      "windowLabel": "main",
      "events": {
        "previous": "media-prev",
        "toggle": "media-toggle",
        "next": "media-next"
      },
      "tooltips": {
        "previous": "Previous",
        "play": "Play",
        "pause": "Pause",
        "next": "Next"
      },
      "icons": {
        "previous": "icons/taskbar/PREV_THUMB.ico",
        "previousDisabled": "icons/taskbar/PREV_THUMB_DISABLED.ico",
        "play": "icons/taskbar/PLAY_THUMB.ico",
        "pause": "icons/taskbar/PAUSE_THUMB.ico",
        "next": "icons/taskbar/NEXT_THUMB.ico",
        "nextDisabled": "icons/taskbar/NEXT_THUMB_DISABLED.ico"
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJDOURCMzI0MzU0MTZERTkKUldUcGJVRTFKTE9kTE5tNnRoZGp6bURzeEQ2RUE5eWM3blBXU3psdHU1UEtpcGpwQ3hGQWlkNE0K",
      "endpoints": [
        "https://github.com/Romany-Osama/Meld-Desktop/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      }
    },
    "resources": [
      "icons/taskbar/PREV_THUMB.ico",
      "icons/taskbar/PREV_THUMB_DISABLED.ico",
      "icons/taskbar/PLAY_THUMB.ico",
      "icons/taskbar/PAUSE_THUMB.ico",
      "icons/taskbar/NEXT_THUMB.ico",
      "icons/taskbar/NEXT_THUMB_DISABLED.ico"
    ],
    "publisher": "Romany-Osama",
    "copyright": "Copyright (C) 2026 Romany-Osama and Meld contributors. GPL-3.0-only.",
    "category": "Music",
    "shortDescription": "Lightweight native Windows client for YouTube Music",
    "longDescription": "Meld Desktop is a Windows-native Tauri/Rust/React adaptation of the open-source Meld music client. It is not an official Meld release.",
    "license": "GPL-3.0-only",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  }
}
