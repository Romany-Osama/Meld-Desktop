{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Meld Desktop",
  "version": "0.1.0",
  "identifier": "com.romany-osama.meld-desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
        "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
                "title": "Meld Desktop",
        "width": 1120,
        "height": 720,
        "minWidth": 860,
        "minHeight": 600


      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$HOME/**", "$APPDATA/**", "$DOCUMENT/**", "$DOWNLOAD/**", "$MUSIC/**", "$DESKTOP/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
